PORT=3001
NODE_ENV=development

# Conexão PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=districommerce_users
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/districommerce_users

# Autenticação JWT
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h
